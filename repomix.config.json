{
  "output": {
    "filePath": "repomix-output.txt",
    "style": "plain",
    "parsableStyle": false,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "includeEmptyDirectories": false,
    "showLineNumbers": false
  },
  "include": ["frontend/**", "studio-athletica/**"],
  "ignore": {
    "useGitignore": false,
    "useDefaultPatterns": true,
    "customPatterns": [
      "frontend/data/**",
      "frontend/public/**",
      "frontend/coverage/**",
      "frontend/playwright-report/**",
      "frontend/test-results/**",
      "frontend/screenshots/**",
      "frontend/.next/**",
      "frontend/out/**",
      "frontend/build/**",
      "frontend/.vercel/**",
      "frontend/.webforge/**",
      "frontend/athletica-audit.md",
      "frontend/athletica-patches/**",
      "frontend/plan/**",
      "frontend/prompts/**",
      "frontend/issues/**",
      "frontend/memory/**",
      "frontend/docs/**",
      "frontend/extract_nav.py",
      "studio-athletica/dist/**",
      "studio-athletica/.sanity/**",
      "studio-athletica/logs/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/.env*",
      "**/.DS_Store",
      "**/*.pem",
      "**/*.tsbuildinfo",
      "**/next-env.d.ts",
      "**/*.log",
      "**/.admin-credentials",
      "**/*.md",
      "**/.gitignore",
      "**/.gitkeep",
      "**/.env.example",
      "**/e2e/**",
      "frontend/scripts/**",
      "studio-athletica/scripts/**",
      "studio-athletica/copy-sanity-data.mjs",
      "studio-athletica/fix-gallery-keys.mjs",
      "studio-athletica/generate-images.mjs",
      "studio-athletica/sanity-diff.mjs",
      "studio-athletica/seed-admin.mjs",
      "studio-athletica/seed.mjs",
      "studio-athletica/sync-to-sanity.mjs",
      "studio-athletica/upload-homepage-images.mjs",
      "studio-athletica/upload-images.mjs",
      "frontend/src/backup-data/**",
      "frontend/playwright.config.ts",
      "frontend/vitest.config.ts",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "frontend/src/test-utils/**",
      "frontend/src/lib/mocks/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}