# Athletica rollout app — environment variables

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Sanity (server-only)
SANITY_WRITE_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_ID=cuiis46d

# Upstash Redis (rate limit + click dedup + salt cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (error monitoring — PII off)
SENTRY_DSN=

# Amazon Associates (per-marketplace tags live in the `marketplaces` table; this is the default)
AMAZON_ASSOCIATES_TAG=
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=

# Amazon Creators API (optional booster — only when eligible)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=

# Affiliate program
AFFILIATE_POSTBACK_TOKEN=
AFFILIATE_MINIMUM_PAYOUT=50

# Site URL (for metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://athletica.vercel.app

# Cron (Vercel sets this automatically; used to protect /api/cron)
CRON_SECRET=
