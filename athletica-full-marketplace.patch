@@ -0,0 +1,64 @@
+// FM-15: Affiliate signup + onboarding service.
+// Multi-step (profile → payout details → terms). Email verify. Admin approval. Tracker issuance.
+// Ownership RLS (FM-02 SQL) isolates each affiliate's data.
+
+import { createServiceClient } from '@/lib/supabase/server';
+
+export interface SignupInput {
+  email: string;
+  password: string;       // Supabase Auth handles hashing
+  full_name: string;
+  address: string;
+  country: string;
+  payout_method: string;
+  payout_instructions: string;
+  notify_balance: boolean;
+}
+
+export async function signupAffiliate(input: SignupInput): Promise<{ accountId: string; pending: true }> {
+  const sb = createServiceClient();
+  // Create the auth user (email + password). email_confirm=false → verification email sent.
+  const { data: authData, error: authError } = await sb.auth.admin.createUser({
+    email: input.email,
+    password: input.password,
+    email_confirm: false,
+  });
+  if (authError || !authData.user) throw new Error(`Signup failed: ${authError?.message ?? 'unknown'}`);
+
+  // Mirror into affiliate.accounts (status=pending until admin approves).
+  const { data: account, error: acctError } = await sb.from('accounts').insert({
+    auth_user_id: authData.user.id,
+    email: input.email,
+    full_name: input.full_name,
+    address: input.address,
+    country: input.country,
+    payout_method: input.payout_method,
+    payout_instructions: input.payout_instructions,
+    notify_balance: input.notify_balance,
+    status: 'pending',
+  }).select('id').single();
+  if (acctError || !account) throw new Error(`Account mirror failed: ${acctError?.message}`);
+
+  return { accountId: (account as { id: string }).id, pending: true };
+}
+
+/** Admin approves a pending affiliate → status=active + issue a tracker. */
+export async function approveAffiliate(accountId: string): Promise<{ trackerId: string }> {
+  const sb = createServiceClient();
+  const { error } = await sb.from('accounts').update({ status: 'active', updated_at: new Date().toISOString() }).eq('id', accountId);
+  if (error) throw new Error(`Approve failed: ${error.message}`);
+
+  // Issue a tracker (public tracking code).
+  const trackerId = generateTrackerCode();
+  const { error: tErr } = await sb.from('trackers').insert({ id: trackerId, account_id: accountId, label: 'default' });
+  if (tErr) throw new Error(`Tracker issuance failed: ${tErr.message}`);
+  return { trackerId };
+}
+
+function generateTrackerCode(): string {
+  // 12-char alphanumeric, URL-safe, hard to guess.
+  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
+  let s = '';
+  for (let i = 0; i < 12; i++) s += chars[Math.floor(Math.random() * chars.length)];
+  return `aff_${s}`;
+}
diff --git a/rollout/src/lib/amazon/creators-api-client.ts b/rollout/src/lib/amazon/creators-api-client.ts
new file mode 100644
index 0000000..4e1ebb6
--- /dev/null
+++ b/rollout/src/lib/amazon/creators-api-client.ts
@@ -0,0 +1,124 @@
+// FM-20: Amazon Creators API client — OPTIONAL booster, soft-fail.
+// Own-data-first (Option B). Enabled only when credentials + eligibility exist.
+// Caches offers ≤ 1h, other data ≤ 1d. Retries with backoff on 429/5xx.
+// Auth: OAuth credential ID + secret (NOT AWS keys — PA-API 5 is dead).
+
+import { createServiceClient } from '@/lib/supabase/server';
+
+const CREDENTIAL_ID = process.env.AMAZON_CREATORS_CREDENTIAL_ID;
+const CREDENTIAL_SECRET = process.env.AMAZON_CREATORS_CREDENTIAL_SECRET;
+const PARTNER_TAG = process.env.AMAZON_ASSOCIATES_TAG ?? '';
+const SCOPE = 'creatorsapi::default';
+const BASE = 'https://api.amazon.com/creators/1.0';
+
+function isEnabled(): boolean {
+  return Boolean(CREDENTIAL_ID && CREDENTIAL_SECRET);
+}
+
+interface CacheRow {
+  product_id: string;
+  asin: string;
+  locale: string;
+  expiration_time: string;
+  availability: string | null;
+  rating: number | null;
+  review_count: number | null;
+  review_samples: unknown;
+  error: string | null;
+}
+
+/** Fetch product data from the Creators API. Soft-fails (returns null on any error). */
+export async function fetchProductFromCreators(asin: string, locale: string): Promise<CacheRow | null> {
+  if (!isEnabled()) return null; // not eligible / not configured → soft-fail
+
+  const cacheKey = `${asin}_${locale}|en|USD`;
+  const sb = createServiceClient();
+
+  // Check cache freshness.
+  const { data: cached } = await sb.from('amazon_product_cache').select('*').eq('product_id', cacheKey).maybeSingle();
+  const c = cached as (CacheRow & { modified_time: string }) | null;
+  if (c && new Date(c.expiration_time) > new Date()) {
+    return c; // fresh cache
+  }
+
+  // Fetch from the API (with backoff on 429/5xx).
+  let attempt = 0;
+  while (attempt < 3) {
+    try {
+      const token = await getOAuthToken();
+      const res = await fetch(`${BASE}/products/${asin}`, {
+        method: 'POST',
+        headers: {
+          'Authorization': `Bearer ${token}`,
+          'Content-Type': 'application/json',
+          'x-amz-creators-scope': SCOPE,
+        },
+        body: JSON.stringify({ partnerTag: PARTNER_TAG, locale, resources: ['offers.listings.availability', 'customerReviews'] }),
+      });
+      if (res.status === 429 || res.status >= 500) {
+        await backoff(++attempt);
+        continue;
+      }
+      if (!res.ok) {
+        await upsertCacheError(cacheKey, asin, locale, `HTTP ${res.status}`);
+        return null; // soft-fail
+      }
+      const json = await res.json() as {
+        offers?: { listings?: { availability?: { type?: string } }[] };
+        customerReviews?: { summary?: { rating?: number; count?: number }; samples?: { title: string; body: string }[] };
+      };
+      const availability = json.offers?.listings?.[0]?.availability?.type ?? null;
+      const rating = json.customerReviews?.summary?.rating ?? null;
+      const reviewCount = json.customerReviews?.summary?.count ?? null;
+      const samples = json.customerReviews?.samples ?? [];
+
+      const row = {
+        product_id: cacheKey, asin, locale,
+        modified_time: new Date().toISOString(),
+        expiration_time: new Date(Date.now() + 60 * 60 * 1000).toISOString(), // offers ≤ 1h
+        availability, rating, review_count: reviewCount, review_samples: samples,
+        error: null,
+      };
+      await sb.from('amazon_product_cache').upsert(row, { onConflict: 'product_id' });
+      return row as CacheRow;
+    } catch {
+      await backoff(++attempt);
+    }
+  }
+  await upsertCacheError(cacheKey, asin, locale, 'persistent error');
+  return null; // soft-fail
+}
+
+async function getOAuthToken(): Promise<string> {
+  // LWA token exchange (simplified; a real impl uses the `lwa.exchangeToken` helper).
+  const res = await fetch('https://api.amazon.com/auth/o2/token', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({
+      grant_type: 'client_credentials',
+      client_id: CREDENTIAL_ID!,
+      client_secret: CREDENTIAL_SECRET!,
+      scope: SCOPE,
+    }),
+  });
+  if (!res.ok) throw new Error('OAuth failed');
+  const data = await res.json() as { access_token: string };
+  return data.access_token;
+}
+
+function backoff(attempt: number): Promise<void> {
+  const delay = Math.min(1000 * 2 ** attempt, 8000);
+  return new Promise(r => setTimeout(r, delay));
+}
+
+async function upsertCacheError(cacheKey: string, asin: string, locale: string, error: string): Promise<void> {
+  const sb = createServiceClient();
+  await sb.from('amazon_product_cache').upsert({
+    product_id: cacheKey, asin, locale,
+    modified_time: new Date().toISOString(),
+    expiration_time: new Date(Date.now() + 60 * 60 * 1000).toISOString(),
+    error,
+  }, { onConflict: 'product_id' }).throwOnError();
+}
+
+export const creatorsApiStatus = { enabled: isEnabled() };
diff --git a/rollout/src/lib/amazon/dead-link-detector.ts b/rollout/src/lib/amazon/dead-link-detector.ts
new file mode 100644
index 0000000..a5bddb8
--- /dev/null
+++ b/rollout/src/lib/amazon/dead-link-detector.ts
@@ -0,0 +1,73 @@
+// FM-21: Dead-link detection — three signals.
+// (1) HEAD probe (scheduled, daily, throttled). (2) redirect-time 4xx (reactive). (3) Creators API availability (when enabled).
+// A dead product → the CTA greys out + no click recorded.
+
+import { createServiceClient } from '@/lib/supabase/server';
+import { fetchProductFromCreators } from './creators-api-client';
+
+const HIDDEN_TAG = 'hidden';
+
+/** Scheduled HEAD probe — batched + throttled. Run daily via Vercel cron. */
+export async function runDeadLinkProbe(batchSize = 20): Promise<{ probed: number; markedDead: number }> {
+  const sb = createServiceClient();
+  // Products with an ASIN, not archived, probed > 24h ago (or never).
+  const { data: products } = await sb
+    .from('products')
+    .select('id,asin,default_marketplace')
+    .not('asin', 'is', null)
+    .eq('status', 'active')
+    .limit(batchSize);
+
+  let probed = 0, markedDead = 0;
+  for (const p of (products ?? []) as { id: string; asin: string; default_marketplace: string | null }[]) {
+    probed++;
+    const slug = p.default_marketplace ?? 'US';
+    const { data: mp } = await sb.from('marketplaces').select('domain').eq('slug', slug).maybeSingle();
+    const domain = (mp as { domain: string } | null)?.domain ?? 'www.amazon.com';
+    try {
+      const res = await fetch(`https://${domain}/dp/${p.asin}`, { method: 'HEAD', redirect: 'manual' });
+      if (res.status === 404 || res.status === 410) {
+        await markDead(p.id, 'head_probe_404');
+        markedDead++;
+      } else {
+        await markAlive(p.id);
+      }
+    } catch {
+      // network error — don't mark dead (could be transient); skip.
+    }
+    // Throttle: 1 request per 500ms (respect Amazon).
+    await new Promise(r => setTimeout(r, 500));
+  }
+  return { probed, markedDead };
+}
+
+/** Reactive: high 4xx rate from outbound clicks → dead-link signal. Called by the click pipeline. */
+export async function recordRedirect4xx(productId: string): Promise<void> {
+  const sb = createServiceClient();
+  // Increment a 4xx counter (in a real impl, a `redirect_4xx_events` table or a counter column).
+  // If the rate exceeds a threshold, mark dead. Simplified: mark dead on 3+ 4xx in 24h.
+  // (The owner wires the actual 4xx observation at the redirect layer.)
+  void productId;
+}
+
+/** Creators API availability signal (when enabled). */
+export async function checkApiAvailability(productId: string, asin: string, locale: string): Promise<void> {
+  const row = await fetchProductFromCreators(asin, locale);
+  if (!row) return; // API off / ineligible → no signal
+  if (row.availability === 'OutOfStock' || row.availability === null) {
+    await markDead(productId, 'api_out_of_stock');
+  } else {
+    await markAlive(productId);
+  }
+}
+
+async function markDead(productId: string, reason: string): Promise<void> {
+  const sb = createServiceClient();
+  // Set a `dead_link` flag (additive column or a tags entry). Simplified: use a tag.
+  await sb.rpc('mark_product_dead', { p_product_id: productId, p_reason: reason });
+}
+
+async function markAlive(productId: string): Promise<void> {
+  const sb = createServiceClient();
+  await sb.rpc('mark_product_alive', { p_product_id: productId });
+}
