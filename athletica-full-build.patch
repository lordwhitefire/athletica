+  justify-content: space-between;
+  gap: 20px;
+}
+
+.storefront-section-heading h2 {
+  margin: 0;
+  color: #f7f7f7;
+  font-size: clamp(24px, 3vw, 38px);
+  font-weight: 850;
+  letter-spacing: -.045em;
+  text-transform: uppercase;
+}
