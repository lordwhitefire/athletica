+.storefront-section-heading a {
+  color: #d1fd40;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: .08em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.shop-page {
+  width: min(100% - 48px, 1440px);
+  min-height: 70vh;
+  margin: 0 auto;
+  padding: clamp(44px, 6vw, 76px) 0 90px;
+}
+
+.shop-page__eyebrow {
+  margin: 0 0 12px;
+  color: #d1fd40;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .2em;
+  text-transform: uppercase;
+}
