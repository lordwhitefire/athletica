+.storefront-header,
+.storefront-header * {
+  box-sizing: border-box;
+}
+
+.storefront-header {
+  position: relative;
+  z-index: 10;
+  width: 100%;
+  border-bottom: 1px solid #292929;
+  background: #050505;
+}
