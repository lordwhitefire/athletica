+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 18px;
+}
+
+.shop-page__skeleton {
+  aspect-ratio: 4 / 5;
+  background: #101010;
+  animation: shop-pulse 1.4s ease-in-out infinite alternate;
